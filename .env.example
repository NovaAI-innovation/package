# Deployment settings for the knowledge-schema package.
# Copy to .env and fill in. Never commit real credentials.
#
# One set of variables configures both sides: the same values are read by `ks` and
# substituted into compose.yaml, so the client and the containers cannot drift.

# --- PostgreSQL control plane ---------------------------------------------
# The client takes a DSN. Compose takes the parts, which must match the DSN exactly.
KS_PG_DSN=postgresql://postgres:postgres@127.0.0.1:5432/postgres
KS_PG_USER=postgres
KS_PG_PASSWORD=postgres
KS_PG_DB=postgres

# --- SurrealDB ------------------------------------------------------------
KS_SURREAL_URL=http://127.0.0.1:8000
KS_SURREAL_USER=root
KS_SURREAL_PASSWORD=root

# --- FalkorDB -------------------------------------------------------------
# Leave KS_FALKOR_PASSWORD empty for no authentication. If you set it, it becomes the
# server's --requirepass AND the password the client sends.
KS_FALKOR_HOST=127.0.0.1
KS_FALKOR_PORT=6379
KS_FALKOR_PASSWORD=

# --- Published ports ------------------------------------------------------
PG_PORT=5432
SURREAL_PORT=8000
FALKOR_PORT=6379
